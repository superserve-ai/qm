# Local harness environment for the single-container tenant image. Copy to
# deploy/superserve/.env, then generate the secrets marked "openssl rand -hex 32".
# Values here point at deploy/superserve/compose.yaml and are NOT production settings.

# The portal refuses http public URLs in production, so the local harness runs in development
# mode. Production containers keep the image default (NODE_ENV=production).
NODE_ENV=development

# Identity and public address (the supervisor derives WEB_UI_PUBLIC_URL and PORTAL_PUBLIC_URL
# from PUBLIC_WEB_URL; PORTAL_PUBLIC_URL is repeated only so `qm admin-login` can read it).
ORG_ID=local-tenant
PUBLIC_WEB_URL=http://localhost:8080
PORTAL_PUBLIC_URL=http://localhost:8080

# Durable state: compose Postgres, reachable from the container via host.docker.internal.
DATABASE_URL=postgres://qm:qm@host.docker.internal:55432/qm
SESSION_STORE=postgres
RUN_STORE=postgres

# Blob storage: compose MinIO. Requires running the container on the compose network
# (--network qm-superserve) so the bucket host qm-tenant.minio resolves.
SNAPSHOT_STORE=s3
TRANSFER_STORE=s3
S3_BUCKET=qm-tenant
S3_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=http://minio:9000
AWS_ACCESS_KEY_ID=qm-local
AWS_SECRET_ACCESS_KEY=qm-local-secret

# Agent runtime. mock answers with canned text and needs no model key; local is the only
# sandbox backend that constructs without credentials (it is never used by the harness).
HARNESS=mock
SANDBOX_BACKEND=local

# Admin bootstrap: the email `qm admin-login` mints a link for.
ADMIN_GRANTS=admin@example.com:org_admin

# Signing secrets. Each must be distinct: openssl rand -hex 32
CORE_SIGNING_SECRET=
CAPABILITY_SECRET=
PORTAL_IDENTITY_SECRET=
CONNECTOR_SECRET_KEY=
SKILL_SIGNING_SECRET=
PORTAL_SESSION_SECRET=

# Optional: embedded email sign-in broker. Setting AUTH_SIGNING_JWK turns it on.
# AUTH_SIGNING_JWK: node -e "const {generateKeyPairSync}=require('node:crypto');process.stdout.write(JSON.stringify(generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'})))"
#AUTH_SIGNING_JWK=
#AUTH_TOKEN_SECRET=
#AUTH_CLIENT_SECRET=
#AUTH_ALLOWED_EMAIL_DOMAIN=example.com
#AUTH_EMAIL_FROM=QM <no-reply@example.com>
#AUTH_EMAIL_TRANSPORT=resend
#RESEND_API_KEY=re_local_placeholder
